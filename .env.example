# Every setting in backend/watchful/config.py with its default; test_aws.py keeps the two in step. Copy to .env for
# local runs and fill in what you need; never commit .env. Commented lines are unset by default. On AWS,
# deploy/deploy.sh puts the values from deploy/params.env into SSM under /<stack>/ and deploy/ssm_env.py loads them
# when a service starts; settings only for the ioflood tunnel are in deploy/ioflood.env.example.

# parts, each chosen by name (registry.py and components.py)
STORAGE=local
DB=sql
AI_PROVIDER=openrouter
METRICS=log
NOTIFY=log
DETECTOR=yolox_nano
SCAN_DETECTOR=yolox_nano_320
POSE_MODEL=mediapipe
FACE_MODEL=yunet_sface
EMBEDDER=siglip2_b32
OCR=ppocr_v3det_v5rec
# none: plates are read from PP-OCR text boxes only
PLATE_DETECTOR=lpd_yunet

# paths and runtime
DATA_DIR=data
# blank: sqlite:///<DATA_DIR>/watchful.db
# DATABASE_URL=
# blank: web/dist in the repo
# WEB_DIST=
MODELS_DIR=models
# TUNING_FILE=
TIMEZONE=Asia/Kolkata
DNN_ENGINE=auto
NIGHT_MODE=auto

# cameras, scans and search
ANALYSIS_FPS=5.0
ANALYSIS_WIDTH=960
DISPLAY_FPS=10.0
DISPLAY_QUALITY=70
INDEX_EMBEDDINGS=true
DEMO_REALTIME=true
LIVE_FPS_DURING_SCAN=2.0
ALERT_DEDUPE_DAYS=14
SCAN_WORKERS=0
SCAN_POOL_AT_START=true
CAMERA_THREADS=2
SCAN_OVERLAP_S=2.0
RETENTION_DAYS=7
MAX_UPLOAD_MB=200
MAX_UPLOAD_MINUTES=10

# hosting: the address links and the page's socket policy use; true only behind the Cloudflare tunnel (ioflood,
# deploy/ioflood.env.example), where every request comes through Cloudflare and CF-Connecting-IP names the visitor;
# never on AWS, where a visitor could send that header themselves
PUBLIC_BASE_URL=http://localhost:8000
TRUST_CLOUDFLARE=false
# false where systemd runs the job worker on its own (AWS); the job worker sends Telegram alerts and summaries
RUN_JOBS_IN_APP=true

# alerts: incidents go to Telegram (alerts/telegram.py); without TELEGRAM_BOT_TOKEN the log stands in and the app says
# Telegram is not connected. The token is BotFather's; the webhook secret is any random string Telegram sends back
ALERT_CHANNEL=telegram
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_URL=https://api.telegram.org

# secrets: required, no defaults. SESSION_SECRET: any long random string
# (python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET=
# encrypts camera addresses at rest; required. DATA_KEY_OLD lists earlier keys while rotating
DATA_KEY=
# DATA_KEY_OLD=

# sign in: Google (leave blank to offer only the operator's links, python -m watchful.auth signin-link)
AUTH_PROVIDERS=google
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# AI
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# per task models, so compiling, checking and answering can use different ones
# AI_MODEL_COMPILE=
# AI_MODEL_VERIFY=
# AI_MODEL_ASK=
AI_MAX_TOKENS=1500
AI_PARALLEL=6
AI_DAILY_CALL_LIMIT=500
# BEDROCK_MODEL=

# AWS
AWS_REGION=us-east-1
# S3_BUCKET=
# SNS_TOPIC_ARN=
