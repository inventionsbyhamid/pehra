# The main settings with their defaults (backend/watchful/config.py has every one). Copy to .env for local runs
# and fill in what you need; never commit .env. Lines left commented are unset by default. On AWS,
# deploy/deploy.sh puts the values from deploy/params.env into SSM under /<stack>/ and deploy/ssm_env.py loads
# them when a service starts.

# parts, each chosen by name (registry.py and components.py)
STORAGE=local
DB=sql
AI_PROVIDER=openrouter
METRICS=log
NOTIFY=log
DETECTOR=yolox_nano
SCAN_DETECTOR=yolox_nano_320
POSE_MODEL=mediapipe
FACE_MODEL=yunet_sface
EMBEDDER=siglip2_b32

# paths and runtime
DATA_DIR=data
# blank: sqlite:///<DATA_DIR>/watchful.db
# DATABASE_URL=
MODELS_DIR=models
# WEB_DIST=
# TUNING_FILE=
DNN_ENGINE=auto
NIGHT_MODE=auto
TIMEZONE=Asia/Kolkata
ANALYSIS_FPS=5.0
DISPLAY_FPS=10.0
RETENTION_DAYS=7
MAX_UPLOAD_MB=200
MAX_UPLOAD_MINUTES=10

# hosting: the address links and the page's socket policy use; true only behind the Cloudflare tunnel (ioflood,
# deploy/ioflood.env.example), where every request comes through Cloudflare and CF-Connecting-IP names the visitor;
# never on AWS, where a visitor could send that header themselves
PUBLIC_BASE_URL=http://localhost:8000
TRUST_CLOUDFLARE=false
# false where systemd runs the job worker on its own (AWS)
RUN_JOBS_IN_APP=true

# secrets: required, no defaults. SESSION_SECRET: any long random string
# (python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET=
DEMO_PASSWORD=
# encrypts camera addresses at rest; SESSION_SECRET when unset
# DATA_KEY=

# Telegram alerts: the bot's token from BotFather, and any random string Telegram sends back with each update
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=

# AI
# OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MAX_TOKENS=1500
AI_DAILY_CALL_LIMIT=500
# BEDROCK_MODEL=global.anthropic.claude-haiku-5-5

# AWS (the deploy's region)
AWS_REGION=ap-south-1
# S3_BUCKET=
# SSM_PREFIX=
