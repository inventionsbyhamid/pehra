%% Pehra architecture. architecture.svg is drawn from this by hand, in the same layout.
flowchart LR
  subgraph society["At the society"]
    NVR["Recorders and IP cameras<br/>Hikvision, CP Plus, Dahua"]
    BRIDGE["Pehra bridge (OpenCV)<br/>reads RTSP on the LAN, pushes JPEG"]
    PHONE["Laptop or phone as a camera<br/>OpenCV.js YuNet blurs faces first"]
    PEOPLE["Committee and supervisor<br/>web app"]
  end
  subgraph aws["AWS ap-south-1 (Mumbai)"]
    subgraph ec2["EC2 c8g.xlarge, Graviton4, COOL image"]
      CADDY["Caddy: TLS"]
      APP["FastAPI app: society API, sign in,<br/>sockets, camera manager, billing, demo"]
      AGENT["Verifier agent in the app's check pool<br/>OpenCV tools: frames, zoom, CLAHE,<br/>denoise, DIS flow, pose history, path"]
      POOL["Camera processes, one per vCPU (COOL OpenCV 5)<br/>FFmpeg decode, resize, CLAHE, tamper by ORB and MAGSAC,<br/>MOG2, YOLOX on cv2.dnn, Kalman tracker, zones and lines,<br/>DIS flow, pose, YuNet and SFace, LPD-YuNet and PP-OCRv5,<br/>SigLIP 2, watch engine"]
      SCAN["Scan workers: uploads in time chunks"]
      JOBS["Job worker: Telegram posts and edits,<br/>stills with faces blurred, summary,<br/>attendance, stays, retention, demo reset"]
      DB[("SQLite WAL<br/>every row under its society")]
    end
    BEDROCK["Amazon Bedrock<br/>Claude Haiku 5.5"]
    S3[("Amazon S3: pictures, clips,<br/>database copy")]
    CW["CloudWatch: logs, metrics,<br/>dashboard, alarms by SNS"]
    SSM["SSM Parameter Store"]
    CFN["CloudFormation, Budgets"]
  end
  TG["Society's Telegram group<br/>Acknowledge, False alarm"]
  OUT["Polar billing, Google sign in,<br/>OpenRouter on the test server"]

  NVR -- "RTSP pull, rtsp and rtsps only" --> POOL
  PEOPLE -- HTTPS --> CADDY
  BRIDGE -- "WebSocket, JPEG, device token" --> CADDY
  PHONE -- "WebSocket, blurred JPEG" --> CADDY
  CADDY --> APP
  APP <-- "frames in; events, candidates, health out" --> POOL
  APP -- candidates --> AGENT
  AGENT -- "flagged moments only" --> BEDROCK
  POOL -- "keyframes, clips" --> S3
  JOBS <--> DB
  DB -- "Litestream copy" --> S3
  JOBS -- "Bot API" --> TG
  TG -- "taps by webhook" --> CADDY
  SSM -. "settings, secrets" .-> APP
  APP -. "metrics, logs" .-> CW
