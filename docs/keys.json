 },
 "eval.*.fps_*.all.recall": {
  "from": "eval-{1}",
  "path": "runs.fps_{2}.all.recall.value",
  "unit": "pct",
  "means": "recall, every watch together"
 },
 "eval.*.fps_*.all.recall_ci": {
