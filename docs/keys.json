 },
 "eval.*.fps_*.*.recall_failures_at_most": {
  "from": "eval-{1}",
  "path": "runs.fps_{2}.watches.{3}.recall.failures_at_most",
  "unit": "pct",
  "means": "with no miss, the rule of three bound on the miss rate, this watch"
 },
 "eval.*.fps_*.*.precision_failures_at_most": {
  "from": "eval-{1}",
  "path": "runs.fps_{2}.watches.{3}.precision.failures_at_most",
  "unit": "pct",
  "means": "with no false alarm, the rule of three bound on the false alarm share, this watch"
 },
 "eval.*.fps_*.*.tp": {
  "from": "eval-{1}",
  "path": "runs.fps_{2}.watches.{3}.tp",
  "unit": "int",
  "means": "matched, this watch"
 },
 "eval.*.fps_*.*.fp": {
  "from": "eval-{1}",
  "path": "runs.fps_{2}.watches.{3}.fp",
  "unit": "int",
  "means": "false alarms, this watch"
 },
 "eval.*.fps_*.*.fn": {
  "from": "eval-{1}",
  "path": "runs.fps_{2}.watches.{3}.fn",
  "unit": "int",
  "means": "misses, this watch"
 },
 "eval.*.fps_*.*.false_alarms_per_hour": {
  "from": "eval-{1}",
  "path": "runs.fps_{2}.watches.{3}.false_alarms_per_camera_hour",
  "unit": "num",
  "means": "false alarms per camera hour, this watch"
 },
 "eval.*.fps_*.*.truth": {
  "from": "eval-{1}",
  "path": "runs.fps_{2}.watches.{3}.truth",
