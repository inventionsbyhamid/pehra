 "bench.*.date": {
  "from": "bench:{1}",
  "path": "date",
  "unit": "day",
  "means": "the day it ran"
 },
 "bench.*.code": {
  "from": "bench:{1}",
  "path": "code",
  "unit": "text",
  "means": "the commit it ran"
 },
