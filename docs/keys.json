 },
 "eval.*.fps_*.*.delay_p90": {
  "from": "eval-{1}",
  "path": "runs.fps_{2}.watches.{3}.delay_s.p90",
  "unit": "s",
  "means": "90th percentile time from the labelled moment to the candidate"
 },
 "eval.*.fps_*.*.first_false_alarm_at": {
  "from": "eval-{1}",
  "path": "runs.fps_{2}.watches.{3}.first_false_alarm.t_s",
