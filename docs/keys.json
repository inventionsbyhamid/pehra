  "means": "labelled events for this watch"
 },
 "eval.*.fps_*.*.fired": {
  "from": "eval-{1}",
  "path": "runs.fps_{2}.watches.{3}.fired",
  "unit": "int",
  "means": "candidates this watch raised in the scored part"
 },
 "eval.*.fps_*.*.delay_median": {
  "from": "eval-{1}",
  "path": "runs.fps_{2}.watches.{3}.delay_s.median",
  "unit": "s",
