{
 "eval.*.date": {
  "from": "eval-{1}",
  "path": "date",
  "unit": "day",
  "means": "the day the clip was scored"
 },
 "eval.*.code": {
  "from": "eval-{1}",
  "path": "code",
  "unit": "text",
  "means": "the commit that scored it"
 },
 "eval.*.engine": {
  "from": "eval-{1}",
  "path": "engine",
