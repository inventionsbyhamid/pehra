# Copy to deploy/params.env (git ignored, keep it chmod 600) and fill it in. Lines are NAME=value, no inline comments.
# deploy/deploy.sh reads this file; nothing in it is ever printed.

# ---- the deploy ----
# blank AWS_PROFILE and STACK: brand.json's name in lower case; STACK names the dashboard, alarms, log groups,
# budget and the SSM path /<STACK>/
AWS_PROFILE=
REGION=ap-south-1
STACK=
# blank: brand.json's domain
DOMAIN=
# the COOL Graviton4 AMI id for REGION, from AWS Marketplace (prodview-fdvbfiewzuehs) after subscribing
COOL_AMI_ID=ami-0123456789abcdef0
INSTANCE_TYPE=c8g.xlarge
VOLUME_GB=40
# blank: the default VPC and a default subnet
VPC_ID=
SUBNET_ID=
ALERT_EMAIL=you@example.com
# c8g.xlarge all month in Mumbai is about $105 at list price before Bedrock and transfer; about 80 for c8g.large
MONTHLY_BUDGET_USD=150
# the foundation model the agent may call, only through its global inference profile global.<id>
BEDROCK_MODEL_ID=anthropic.claude-haiku-5-5
APP_LOG_RETENTION_DAYS=30
ACCESS_LOG_RETENTION_DAYS=90
# the longest Object Lock the app may put on an incident clip
MAX_LOCK_DAYS=100

# ---- app settings: every other line becomes the SecureString parameter /<STACK>/<NAME> ----
# A blank value is skipped and leaves an existing parameter alone. These win over the instance's environment file.
# Blank SESSION_SECRET, DATA_KEY (encrypts camera addresses) and TELEGRAM_WEBHOOK_SECRET are generated once and then
# kept (never replaced by a later deploy). To rotate DATA_KEY, put the old key in DATA_KEY_OLD with the new one,
# deploy, run python -m watchful.db rotate-keys on the instance, then clear DATA_KEY_OLD.
SESSION_SECRET=
DATA_KEY=
DATA_KEY_OLD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
AI_PROVIDER=bedrock
NOTIFY=
# sign in providers offered, in order; blank keeps the app's default (google)
AUTH_PROVIDERS=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BILLING=
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCTS=
OPENROUTER_API_KEY=
