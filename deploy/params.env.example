# Copy to deploy/params.env (git ignored). No secrets here.
AWS_PROFILE=watchful
REGION=us-east-1
STACK=watchful
INSTANCE_TYPE=c8g.xlarge
KEY_NAME=watchful
SSH_CIDR=203.0.113.7/32
DOMAIN=watch.example.com
CAREGIVER_EMAIL=you@example.com
BUDGET_EMAIL=you@example.com
# empty means stock Ubuntu 24.04 arm64; set to the COOL Marketplace AMI id to run on COOL
AMI_ID=
AI_PROVIDER=openrouter
OPENROUTER_KEY_FILE=~/RailsProjects/remoteworldjobs/.env.openrouter
