# Settings only for the always on app on ioflood (container watchful-app), which is reached only through the
# Cloudflare tunnel (container watchful-tunnel). They go in ~/watchful/app.env next to the rest (../wapp also passes
# TRUST_CLOUDFLARE on its docker run line). ../wapp writes PUBLIC_BASE_URL: brand.json's domain when the named tunnel
# runs (~/watchful/tunnel.token exists), else the quick tunnel's address. The page's policy allows sockets to it.
# Never use these on AWS: there Caddy is the only way in and the app reads the visitor from it.

# every request comes through Cloudflare, so CF-Connecting-IP names the visitor for rate limits; without it every
# visitor shares the tunnel container's address
TRUST_CLOUDFLARE=true
