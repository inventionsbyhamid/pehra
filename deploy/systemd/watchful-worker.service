# deploy/remote_setup.sh fills in @PYTHON@ (COOL's Python) and @APP@
[Unit]
Description=Watchful job worker (Telegram sends, daily summaries, attendance, retention)
After=network-online.target watchful-app.service watchful-egress.service
# never runs without the egress rules (deploy/egress.service): a failed load keeps it stopped
Requires=watchful-egress.service
Wants=network-online.target

[Service]
User=watchful
Group=watchful
EnvironmentFile=/etc/watchful/watchful.env
Environment=MALLOC_ARENA_MAX=2
# no picture decodes past 40 megapixels, whatever its header says (the app checks first, vision/decode.py)
Environment=OPENCV_IO_MAX_IMAGE_PIXELS=40000000
WorkingDirectory=@APP@/current
ExecStart=@PYTHON@ @APP@/current/deploy/ssm_env.py -- @PYTHON@ -m watchful.worker
Restart=always
RestartSec=5
TimeoutStopSec=60
StandardOutput=append:/var/log/watchful/worker.log
StandardError=append:/var/log/watchful/worker.log
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
