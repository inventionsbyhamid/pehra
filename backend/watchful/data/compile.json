  "age_patterns": [
    "(?:\\d{1,2}|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen)\\s*-?\\s*(?:years?|yrs?)\\s*-?\\s*olds?",
