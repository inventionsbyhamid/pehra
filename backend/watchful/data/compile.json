    "(?:less|lower)\\s+than\\s+(?:about\\s+)?(?:\\d{1,3}(?:\\.\\d+)?|one|two|three|four|five|six)\\s*(?:feet|foot|ft|cms?|centimet(?:re|er)s?|inch(?:es)?)",
    "(?:under|below)\\s+(?:about\\s+)?(?:\\d{1,3}(?:\\.\\d+)?|one|two|three|four|five|six)\\s*(?:feet|foot|ft|cms?|centimet(?:re|er)s?|inch(?:es)?)",
