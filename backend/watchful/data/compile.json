    "under\\s*-?\\s*\\d{1,2}s",
    "u\\s*-?\\s*\\d{1,2}s?",
    "(?:person|someone|somebody|anyone|individual|child|kid|boy|girl|baby|toddler|teen|teenager|youngster|minor|student|pupil)s?\\s+(?:of|aged)\\s+(?:about|around|roughly|maybe|perhaps|approximately|approx\\.?|nearly|almost|just|under|over|below|above)?\\s*(?:\\d{1,2}|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen)(?:\\s*(?:or|to|-)\\s*(?:\\d{1,2}|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen))?",
    "(?:\\d{1,2}|ek|do|teen|char|chaar|paanch|panch|chhe|chhah|saat|aath|nau|das|gyarah|barah|baarah|terah|chaudah|pandrah|solah|satrah)\\s*saal\\s+(?:ka|ki|ke)",
    "(?:class|std\\.?|standard|grade)\\s*-?\\s*(?:(?:\\d{1,2}|one|two|three|four|five|six|seven|eight|nine|ten|eleven|twelve|thirteen|fourteen|fifteen|sixteen|seventeen|eighteen|nineteen)|(?:\\d{1,2}(?:st|nd|rd|th)|first|second|third|fourth|fifth|sixth|seventh|eighth|ninth|tenth|eleventh|twelfth)|[ivx]{1,4})\\s+(?:students?|pupils?|kids?|boys?|girls?|child|children)",
    "(?:\\d{1,2}(?:st|nd|rd|th)|first|second|third|fourth|fifth|sixth|seventh|eighth|ninth|tenth|eleventh|twelfth)\\s*-?\\s*(?:graders?|standard|std\\b\\.?)",
