{
  "enters": {
    "description": "Something comes into a zone",
    "defaults": {
      "classes": [
        "person"
      ]
    },
    "watch": {
      "name": "Enters $zone",
      "subject": {
        "classes": "$classes"
      },
      "conditions": [
        {
          "signal": "entered",
          "zones": [
            "$zone"
          ]
        }
      ],
      "verify": "Is it really coming into the $zone?"
    }
  },
  "leaves": {
    "description": "Something leaves a zone",
    "defaults": {
      "classes": [
        "person"
      ]
    },
    "watch": {
      "name": "Leaves $zone",
      "subject": {
        "classes": "$classes"
      },
      "conditions": [
        {
          "signal": "exited",
          "zones": [
            "$zone"
          ]
        }
      ],
      "verify": "Is it really leaving the $zone?"
    }
  },
  "stays_too_long": {
    "description": "Someone stays in a zone longer than a number of seconds",
    "defaults": {
      "classes": [
        "person"
      ],
      "value": 60
    },
    "watch": {
      "name": "Stays in $zone",
      "subject": {
        "classes": "$classes"
      },
      "conditions": [
        {
          "signal": "dwell_s",
          "zones": [
            "$zone"
          ],
          "op": ">=",
          "value": "$value"
        }
      ],
      "severity": "warning",
      "verify": "Is someone still in the $zone?"
    }
  },
  "too_many": {
    "description": "More than a number of things in a zone at once",
    "defaults": {
      "classes": [
        "person"
      ],
      "value": 5
    },
    "watch": {
      "name": "Too many in $zone",
      "subject": {
        "classes": "$classes"
      },
      "conditions": [
        {
          "signal": "count",
          "zones": [
            "$zone"
          ],
          "op": ">=",
          "value": "$value"
        }
      ],
      "severity": "warning",
      "verify": "Are there really that many in the $zone?"
    }
  },
  "fall": {
    "description": "A person falls and stays down",
    "defaults": {},
    "watch": {
      "name": "Fall",
      "subject": {
        "classes": [
          "person"
        ]
      },
      "conditions": [
        {
          "signal": "posture",
          "op": "is",
          "value": "fallen"
        }
      ],
      "severity": "critical",
      "verify": "Has this person fallen and not got up?",
      "cooldown_s": 10
    }
  },
  "about_to_fall": {
    "description": "A person loses balance and starts to fall",
    "defaults": {},
    "watch": {
      "name": "About to fall",
      "subject": {
        "classes": [
          "person"
        ]
      },
      "conditions": [
        {
          "signal": "posture",
          "op": "is",
          "value": "falling"
        }
      ],
      "severity": "warning",
      "verify": "Is this person losing balance or falling?",
      "cooldown_s": 10
    }
  },
  "possible_intruder": {
    "description": "Someone not enrolled behaves like they are trying to get in, at night (behaviour only)",
    "defaults": {
      "entries": [],
      "climbs": [],
      "start": "22:00",
      "end": "06:00"
    },
    "watch": {
      "name": "Possible intruder",
      "subject": {
        "classes": [
          "person"
        ],
        "who": "unknown"
      },
      "conditions": [
        {
          "signal": "dwell_s",
          "zones": "$entries",
          "op": ">=",
          "value": 20,
          "weight": 2
        },
        {
          "signal": "zones_visited",
          "zones": "$entries",
          "op": ">=",
          "value": 2,
          "params": {
            "window_s": 300
          },
          "weight": 2
        },
        {
          "signal": "hands_in_zone_s",
          "zones": "$entries",
          "op": ">=",
          "value": 3,
          "weight": 1
        },
        {
          "signal": "climbing",
          "zones": "$climbs",
          "weight": 3
        },
        {
          "signal": "returns",
          "op": ">=",
          "value": 3,
          "params": {
            "window_s": 1800
          },
          "weight": 1
        }
      ],
      "combine": "score",
      "threshold": 2,
      "time_window": {
        "start": "$start",
        "end": "$end"
      },
      "severity": "critical",
      "verify": "Does this look like someone trying to get in, rather than a visitor or worker?"
    }
  },
  "lookout": {
    "description": "Tell me when a person shows up: an enrolled person, a description, or someone seen before",
    "defaults": {
      "who": "anyone",
      "text": null,
      "same_as": null
    },
    "watch": {
      "name": "Lookout",
      "subject": {
        "classes": [
          "person"
        ],
        "who": "$who",
        "looks_like": "$text",
        "same_as": "$same_as"
      },
      "conditions": [
        {
          "signal": "present"
        }
      ],
      "severity": "warning",
      "cooldown_s": 600,
      "verify": "Is this the person the owner is looking out for?"
    }
  },
  "gate_left_open": {
    "description": "A zone looks open (or any state you describe) for a while",
    "defaults": {
      "text": "an open gate",
      "not_text": "a closed gate",
      "hold": 60
    },
    "watch": {
      "name": "$zone left open",
      "conditions": [
        {
          "signal": "zone_looks_like",
          "zones": [
            "$zone"
          ],
          "params": {
            "text": "$text",
            "not_text": "$not_text",
            "hold_s": "$hold"
          }
        }
      ],
      "severity": "warning",
      "cooldown_s": 1800,
      "verify": "Does the $zone look open?"
    }
  },
  "looks_like_check": {
    "description": "Someone or something looks a certain way: glasses, helmet, vest, mask, uniform, carrying something",
    "defaults": {
      "classes": [
        "person"
      ],
      "text": "a person not wearing a helmet",
      "not_text": "a person wearing a helmet"
    },
    "watch": {
      "name": "$text",
      "subject": {
        "classes": "$classes"
      },
      "conditions": [
        {
          "signal": "looks_like",
          "params": {
            "text": "$text",
            "not_text": "$not_text"
          }
        }
      ],
      "severity": "warning",
      "cooldown_s": 600,
      "verify": "Does this look like $text?"
    }
  },
  "camera_problem": {
    "description": "A camera is covered or offline (every society starts with this one, for all its cameras)",
    "watch": {
      "name": "A camera is covered or offline",
      "scope": "site",
      "conditions": [
        {
          "signal": "camera_health",
          "op": "in",
          "value": ["covered", "offline"]
        }
      ],
      "severity": "warning",
      "cooldown_s": 600
    }
  }
}
